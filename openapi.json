{
  "openapi": "3.1.0",
  "info": {
    "title": "OPV2 EML / Skywin / VF Vinflair Assign-Parcels Generator",
    "description": "Upload EML (Parcel No col G + Bag ID col H + optional bag list col B/F), Skywin (LM Tracking col B + Carton No col F + Carton Weight col L) or VF Vinflair (LM Tracking col A + Carton Number col B + Carton Weight col T) — up to 3 manifest files merged — and generate 4-column Bag/Parcel/Manifest Weight/Bag Weight CSV: 1 parcel per bag (random if multiple), JT prefix for 6*, WNJPH bag=parcel, weights from bag/carton, MAWB-based filename. Rows whose Bag/Parcel don't look like IDs (must be alphanumeric with digits, e.g. 00000OB/TT/WS/XGFJOB bags, WNJPH/JT/PT parcels - junk address/phone text auto-excluded and reported). Large Excel auto-converts to CSV + auto-splits; 30MB warn / 40MB block with popup; 502/504 shows popup + auto-refreshes.",
    "version": "0.6.1"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["system"],
        "summary": "Health",
        "description": "Substrait calls this to decide whether the app started correctly.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/api/info": {
      "get": {
        "summary": "Info",
        "description": "Returns app name and server time.",
        "operationId": "info_api_info_get",
        "responses": {
          "200": {
            "description": "Application information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "app": { "type": "string" },
                    "server_time": { "type": "string", "example": "2026-08-20 06:15:48 UTC" }
                  },
                  "required": ["app", "server_time"]
                }
              }
            }
          }
        }
      }
    },
    "/api/generate": {
      "post": {
        "summary": "Generate assign-parcels data",
        "description": "Upload 1-3 manifest files (.xlsx/.xls/.csv): EML uses Parcel No/Bag ID + optional bag list (Bag ID/Carton Weight); Skywin uses LM Tracking/Carton No/Carton Weight (B/F/L); VF Vinflair uses LM Tracking/Carton Number/Carton Weight (A/B/T) — merged. Form field carrier: auto (default), eml, skywin, vf. Returns grouped 1-per-bag rows, JT prefix for 6*, random pick, MAWB-based filename.",
        "operationId": "generate_api_generate_post",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary", "description": "Parcel manifest Excel (backward compat single)" },
                  "files": { "type": "array", "items": { "type": "string", "format": "binary" }, "description": "Parcel manifest files, up to 3 (preferred)" },
                  "bag_file": { "type": "string", "format": "binary", "description": "Optional bag list Excel (EML only)" },
                  "carrier": { "type": "string", "enum": ["auto", "eml", "skywin", "vf"], "default": "auto", "description": "Carrier template" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer" },
                    "parcels_raw": { "type": "integer" },
                    "bags_unique": { "type": "integer" },
                    "excluded": { "type": "integer", "description": "Parcel rows auto-excluded whose Bag/Parcel did not look like IDs" },
                    "warnings": { "type": "array", "items": { "type": "string" } },
                    "carrier": { "type": "string" },
                    "mawb": { "type": "string" },
                    "filename": { "type": "string" },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Bag": { "type": "string" },
                          "Parcel": { "type": "string" },
                          "Manifest Weight": { "type": "number" },
                          "Bag Weight": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/generate/csv": {
      "post": {
        "summary": "Generate and download CSV",
        "description": "Same as /api/generate but returns CSV file directly with headers Bag,Parcel,Manifest Weight,Bag Weight and Content-Disposition filename based on MAWB. Supports up to 3 manifest files.",
        "operationId": "generate_csv_api_generate_csv_post",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "files": { "type": "array", "items": { "type": "string", "format": "binary" } },
                  "bag_file": { "type": "string", "format": "binary" },
                  "carrier": { "type": "string", "enum": ["auto", "eml", "skywin", "vf"], "default": "auto" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CSV file",
            "content": {
              "text/csv": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
