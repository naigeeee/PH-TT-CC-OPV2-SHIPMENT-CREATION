FROM python:3.12-slim

WORKDIR /app

# NOTE: no in-pod nginx. Stock Debian nginx runs its startup chown() as root and the
# platform drops all Linux capabilities, so nginx dies with
#   [emerg] chown("/var/lib/nginx/body", 33) failed (1: Operation not permitted)
# leaving every pod NOT READY (ingress 502). uvicorn serves port 8000 directly;
# upload/timeout limits are enforced in app code (50MB/file) and the frontend
# (Excel->CSV auto-split, chunked+gzip, 30MB warn / 40MB block).

COPY backend/requirements.txt ./requirements.txt
# --only-binary: python:3.12-slim has no C compiler, so a package without a wheel would
# otherwise attempt a source build and fail deep in a cryptic compile.
RUN pip install --no-cache-dir --only-binary=:all: -r requirements.txt

COPY backend/ ./
COPY cicd/start.sh ./start.sh
RUN chmod +x ./start.sh

# Substrait requires the backend on port 8000, serving GET /health.
EXPOSE 8000

CMD ["bash", "./start.sh"]
